# Environment: Development
# Description: Environment variables for the development environment.
# Note: Do not commit sensitive information to version control.

VITE_BODEGA_API_BASE_URL="http://localhost:5294/api/v1"
VITE_AUTHENTICATION_ENDPOINT_PATH="/authentication"
VITE_USERS_ENDPOINT_PATH="/users"
VITE_ROLES_ENDPOINT_PATH="/roles"
VITE_BUSINESSES_ENDPOINT_PATH="/businesses"
VITE_WAREHOUSES_ENDPOINT_PATH="/warehouses"
VITE_PRODUCTS_ENDPOINT_PATH="/products"
VITE_BATCHES_ENDPOINT_PATH="/batches"
VITE_INVENTORIES_ENDPOINT_PATH="/inventories"
VITE_STOCK_MOVEMENTS_ENDPOINT_PATH="/stock-movements"
VITE_SALES_ENDPOINT_PATH="/sales"
VITE_SALE_DETAILS_ENDPOINT_PATH="/sale-details"
VITE_CUSTOMERS_ENDPOINT_PATH="/customers"
VITE_SUPPLIERS_ENDPOINT_PATH="/suppliers"
VITE_PURCHASES_ENDPOINT_PATH="/purchases"
VITE_PURCHASE_DETAILS_ENDPOINT_PATH="/purchase-details"
VITE_ALERTS_ENDPOINT_PATH="/alerts"
VITE_ALERT_RULES_ENDPOINT_PATH="/alert-rules"

# Dashboard/Reports/PaymentPlans are not wired up on the frontend yet (that's
# Fase F5) — dashboard.api.js currently computes its own numbers client-side
# from /sales, so there is nothing to point these at until that phase.
# VITE_METRICS_ENDPOINT_PATH used to live here pointing at "/metrics", which
# was never a real backend route (the actual endpoints are /dashboard and
# /reports) and was never read by any code — dead, misleading config.
